{
  "name": "csharp-workbench",
  "displayName": "C# Workbench",
  "version": "0.0.1",
  "publisher": "csharp-workbench",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "node scripts/vitest-safe.mjs run --exclude '**/*.int.test.ts' --exclude '**/node_modules/**'",
    "test:cli": "node scripts/vitest-safe.mjs run test/integration/cli-cpm.int.test.ts",
    "test:int": "node scripts/vscode-test-safe.mjs",
    "build:test": "node esbuild.mjs --tests"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "csharpWorkbench.manageNuget",
        "title": "%command.manageNuget.title%",
        "category": "C# Workbench"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "csharpWorkbench.manageNuget",
          "when": "resourceExtname =~ /^\\.(sln|slnx|csproj)$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "csharpWorkbench.manageNuget"
        }
      ]
    },
    "configuration": {
      "title": "C# Workbench",
      "properties": {
        "csharpWorkbench.dotnetPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.dotnetPath.description%"
        }
      }
    }
  }
}
