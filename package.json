{
  "name": "csharp-workbench",
  "displayName": "C# Workbench",
  "description": "A Visual Studio-style NuGet package manager for .NET solutions and projects in VS Code.",
  "version": "0.1.0",
  "publisher": "TODO-publisher",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "node scripts/vitest-safe.mjs run --exclude '**/*.int.test.ts' --exclude '**/node_modules/**'",
    "test:cli": "node scripts/vitest-safe.mjs run test/integration/cli-cpm.int.test.ts test/integration/slnFolders.int.test.ts",
    "test:int": "node scripts/vscode-test-safe.mjs",
    "build:test": "node esbuild.mjs --tests",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "csharpWorkbench.manageNuget",
        "title": "%command.manageNuget.title%",
        "category": "C# Workbench"
      },
      {
        "command": "csharpWorkbench.selectSolution",
        "title": "%command.selectSolution.title%",
        "category": "C# Workbench",
        "icon": "$(list-selection)"
      },
      {
        "command": "csharpWorkbench.refresh",
        "title": "%command.refresh.title%",
        "category": "C# Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "csharpWorkbench.toggleShowAllFiles",
        "title": "%command.showAllFiles.title%",
        "category": "C# Workbench",
        "icon": "$(eye-closed)"
      },
      {
        "command": "csharpWorkbench.hideAllFiles",
        "title": "%command.hideAllFiles.title%",
        "category": "C# Workbench",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "csharpWorkbench.manageNuget",
          "when": "resourceExtname =~ /^\\.(sln|slnx|csproj)$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "csharpWorkbench.manageNuget"
        }
      ],
      "view/title": [
        {
          "command": "csharpWorkbench.selectSolution",
          "when": "view == csharpWorkbench.solutionExplorer && csharpWorkbench.multipleSolutions",
          "group": "navigation@1"
        },
        {
          "command": "csharpWorkbench.refresh",
          "when": "view == csharpWorkbench.solutionExplorer",
          "group": "navigation@2"
        },
        {
          "command": "csharpWorkbench.toggleShowAllFiles",
          "when": "view == csharpWorkbench.solutionExplorer && !csharpWorkbench.showAllFiles",
          "group": "navigation@3"
        },
        {
          "command": "csharpWorkbench.hideAllFiles",
          "when": "view == csharpWorkbench.solutionExplorer && csharpWorkbench.showAllFiles",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "C# Workbench",
      "properties": {
        "csharpWorkbench.dotnetPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.dotnetPath.description%"
        },
        "csharpWorkbench.solutionExplorer.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoReveal.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "csharpWorkbench",
          "title": "Solution Explorer",
          "icon": "media/solution-explorer.svg"
        }
      ]
    },
    "views": {
      "csharpWorkbench": [
        {
          "id": "csharpWorkbench.solutionExplorer",
          "name": "Solution Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "csharpWorkbench.solutionExplorer",
        "contents": "%viewsWelcome.noSolution%",
        "when": "!csharpWorkbench.hasSolution"
      }
    ]
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "nuget",
    "csharp",
    "dotnet",
    "package manager",
    "visual studio"
  ]
}
