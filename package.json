{
  "name": "csharp-workbench",
  "displayName": "C# Workbench",
  "description": "Visual Studio-style tools for .NET in VS Code: NuGet package manager, Solution Explorer, Project Properties, launch profiles and Sync Namespaces.",
  "version": "0.3.0",
  "publisher": "TODO-publisher",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test:unit": "node scripts/vitest-safe.mjs run --exclude '**/*.int.test.ts' --exclude '**/node_modules/**'",
    "test:cli": "node scripts/vitest-safe.mjs run test/integration/cli-cpm.int.test.ts test/integration/slnFolders.int.test.ts test/integration/properties.int.test.ts",
    "test:int": "node scripts/vscode-test-safe.mjs",
    "build:test": "node esbuild.mjs --tests",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "csharpWorkbench.manageNuget",
        "title": "%command.manageNuget.title%",
        "category": "C# Workbench"
      },
      {
        "command": "csharpWorkbench.selectSolution",
        "title": "%command.selectSolution.title%",
        "category": "C# Workbench",
        "icon": "$(list-selection)"
      },
      {
        "command": "csharpWorkbench.refresh",
        "title": "%command.refresh.title%",
        "category": "C# Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "csharpWorkbench.toggleShowAllFiles",
        "title": "%command.showAllFiles.title%",
        "category": "C# Workbench",
        "icon": "$(eye-closed)"
      },
      {
        "command": "csharpWorkbench.hideAllFiles",
        "title": "%command.hideAllFiles.title%",
        "category": "C# Workbench",
        "icon": "$(eye)"
      },
      {
        "command": "csharpWorkbench.newItem",
        "title": "%command.newItem.title%",
        "category": "C# Workbench"
      },
      {
        "command": "csharpWorkbench.newClass",
        "title": "%command.newClass.title%",
        "category": "C# Workbench"
      },
      {
        "command": "csharpWorkbench.newInterface",
        "title": "%command.newInterface.title%",
        "category": "C# Workbench"
      },
      {
        "command": "csharpWorkbench.newFolder",
        "title": "%command.newFolder.title%",
        "category": "C# Workbench"
      },
      {
